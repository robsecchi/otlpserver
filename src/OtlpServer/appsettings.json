{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "OtlpGrpc": {
        "Url": "http://0.0.0.0:4317",
        "Protocols": "Http2"
      },
      "OtlpHttp": {
        "Url": "http://0.0.0.0:4318",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Otlp": {
    "Grpc": {
      "MaxReceiveMessageSize": 4194304,
      "MaxDecompressedMessageSize": 4194304
    },
    "Logs": {
      "MaxConcurrentExports": 64,
      "ThrottleRetryDelay": "00:00:01",
      "SimulatedProcessingDelay": "00:00:00",
      "Validation": {
        "DuplicateAttributeKeys": "Reject"
      }
    }
  }
}
