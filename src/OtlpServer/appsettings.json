{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "OtlpGrpc": {
        "Url": "http://0.0.0.0:4317",
        "Protocols": "Http2"
      },
      "OtlpHttp": {
        "Url": "http://0.0.0.0:4318",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Otlp": {
    "Grpc": {
      "MaxReceiveMessageSize": 4194304,
      "MaxDecompressedMessageSize": 4194304
    },
    "Http": {
      "MaxRequestBodySize": 4194304,
      "MaxDecompressedBodySize": 4194304
    },
    "Security": {
      "RequireSecure": false,
      "ClientCertificates": {
        "Mode": "NoCertificate"
      },
      "Authentication": {
        "Mode": "None",
        "Clients": []
      }
    },
    "Admission": {
      "RetryDelay": "00:00:01",
      "PerClient": {
        "Overrides": {}
      }
    },
    "Logs": {
      "SimulatedProcessingDelay": "00:00:00",
      "Validation": {
        "DuplicateAttributeKeys": "Reject"
      }
    }
  }
}
